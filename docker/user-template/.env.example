# =============================================================================
# Конфигурация пользовательского стека симуляции
# Каждый пользователь заполняет этот файл под себя на своей машине.
# Файл НЕ коммитится — изменения остаются только локально.
# =============================================================================

# -----------------------------------------------------------------------------
# Идентификация пользователя  ← ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ
# Совпадает с именем системного пользователя на сервере
# (korolenkoelizaveta, ruslanmuhamed123, kravectrofim)
# Определяет имена контейнеров в сети sim-shared:
#   <USER_PREFIX>-sumo, <USER_PREFIX>-matsim, <USER_PREFIX>-webots
# -----------------------------------------------------------------------------
USER_PREFIX=changeme

# -----------------------------------------------------------------------------
# Хостовые порты — уникальны для каждого пользователя, чтобы избежать конфликтов
#
# Рекомендуемое распределение:
#   korolenkoelizaveta: STREAM=1234, TRACI=8813, VIEWER=8080, SUMO_NOVNC=6083, NOVNC=6080
#   ruslanmuhamed123:   STREAM=1235, TRACI=8814, VIEWER=8081, SUMO_NOVNC=6084, NOVNC=6081
#   kravectrofim:       STREAM=1236, TRACI=8815, VIEWER=8082, SUMO_NOVNC=6085, NOVNC=6082
#   ubuntu:             STREAM=1237, TRACI=8816, VIEWER=8083, SUMO_NOVNC=6086, NOVNC=6090
# -----------------------------------------------------------------------------
STREAM_HOST_PORT=1234
TRACI_HOST_PORT=8813
VIEWER_HOST_PORT=8080
SUMO_NOVNC_HOST_PORT=6083
NOVNC_HOST_PORT=6080

# -----------------------------------------------------------------------------
# Версии компонентов
# -----------------------------------------------------------------------------
MATSIM_VERSION=15.0
WEBOTS_TAG=R2023b
WEBOTS_DEB=webots_2023b_amd64.deb

# -----------------------------------------------------------------------------
# Пути к данным (относительно директории, откуда запускается compose)
# -----------------------------------------------------------------------------
SCENARIOS_PATH=./scenarios
MATSIM_INPUT=./matsim-scenarios/input
MATSIM_OUTPUT=./matsim-output
WORLDS_PATH=./worlds

WEBOTS_WORLD=/worlds/city.wbt
WEBOTS_SCREEN_RES=1920x1080x24
# Включить noVNC (доступ к GUI через браузер на NOVNC_HOST_PORT)?
NOVNC_ENABLED=false
SUMO_SCREEN_RES=1920x1080x24

# -----------------------------------------------------------------------------
# Ресурсные лимиты
# -----------------------------------------------------------------------------
WEBOTS_MEM_LIMIT=16g
MATSIM_HEAP=8g
MATSIM_HEAP_MIN=2g
MATSIM_MEM_LIMIT=12g
MATSIM_MEM_RESERVE=2g
